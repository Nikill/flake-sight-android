<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name" translatable="false">Flake Sight</string>
    <string name="resorts_title">Resorts</string>
    <plurals name="webcam_count">
        <item quantity="one">%d webcam</item>
        <item quantity="other">%d webcams</item>
    </plurals>
    <string name="forecast_only">Forecast only</string>

    <!-- Resort list -->
    <string name="search_prompt">Resort, region or webcam</string>
    <string name="clear_search">Clear search</string>
    <!-- %1$s is what the user typed. -->
    <string name="no_search_results">No resort matches “%1$s”.</string>
    <string name="sort">Sort</string>
    <string name="sort_name">Name</string>
    <string name="sort_snow_forecast">Snow Forecast</string>
    <string name="sort_recent_snow">Recent Snow</string>
    <!-- Read by TalkBack for a row's snow figure: %1$s is "24 cm", %2$d a number of days. -->
    <string name="snow_in_last_days">%1$s in the last %2$d days</string>
    <string name="snow_expected_next_days">%1$s expected in the next %2$d days</string>
    <string name="favourites_on_top">Favourites on Top</string>

    <!-- Shown beside the list on a wide window before a resort is chosen. -->
    <string name="select_resort">Choose a resort to see its webcams.</string>

    <!-- Resort screen -->
    <string name="back">Back</string>
    <string name="website">Website</string>
    <string name="no_webcams">No webcams</string>
    <string name="no_webcams_description">This resort does not publish a webcam Flake Sight can show yet.</string>

    <!-- Favourites -->
    <string name="add_to_favourites">Add to Favourites</string>
    <string name="remove_from_favourites">Remove from Favourites</string>
    <string name="favourite">Favourite</string>
    <!-- After a favourite in the list: the resort the widgets will show. -->
    <string name="default_label">Default</string>
    <string name="default_resort">Default resort</string>
    <string name="set_as_default">Set as Default</string>
    <string name="favourites_not_saved">Favourites Not Saved</string>
    <!-- %1$s is the system's reason, e.g. "No space left on device". -->
    <string name="change_not_saved">This change couldn\'t be saved: %1$s</string>
    <string name="ok">OK</string>

    <!-- Forecast strip -->
    <string name="weather">Weather</string>
    <!-- Required credit for Open-Meteo's CC BY 4.0 data. -->
    <string name="weather_data_by_open_meteo">Weather data by Open-Meteo</string>
    <string name="condition_clear">Clear</string>
    <string name="condition_partly_cloudy">Partly cloudy</string>
    <string name="condition_cloudy">Cloudy</string>
    <string name="condition_fog">Fog</string>
    <string name="condition_rain">Rain</string>
    <string name="condition_snow">Snow</string>
    <string name="condition_thunderstorm">Thunderstorm</string>
    <!-- Read by TalkBack: %1$s is an altitude, "2,700 m". -->
    <string name="level_summit">Summit, %1$s</string>
    <string name="level_village">Village, %1$s</string>
    <string name="level_resort">Resort</string>
    <!-- Inside a sentence, after an amount: "24 cm at the summit". -->
    <string name="place_summit">at the summit</string>
    <string name="place_village">in the village</string>
    <string name="place_resort">at the resort</string>
    <!-- %1$d is a number of days, %2$s a list such as "24 cm at the summit, none in the village". -->
    <string name="recent_snow">In the last %1$d days: %2$s.</string>
    <!-- %1$s is a place phrase, "in the village". -->
    <string name="recent_snow_none_at">none %1$s</string>
    <string name="no_recent_snow">No snow in the last %1$d days.</string>
    <string name="forecast_details">Forecast Details</string>
    <!-- Read by TalkBack after "Forecast Details". -->
    <string name="expanded">Expanded</string>
    <string name="collapsed">Collapsed</string>
    <!-- %1$s is a weekday, "Saturday". The night runs from 18:00 to 09:00. -->
    <string name="period_morning">%1$s morning</string>
    <string name="period_afternoon">%1$s afternoon</string>
    <string name="period_night">%1$s night</string>
    <string name="no_snow_next_24_hours">No snow expected in the next 24 hours.</string>
    <!-- %1$s is a place phrase, "at the summit"; %2$s and %3$s times, "15:00" or "Saturday 03:00"; %4$s an amount, "4 cm". -->
    <string name="snow_expected_from_to">Snow expected %1$s from %2$s to %3$s: about %4$s.</string>
    <!-- %1$s is a place phrase, %2$s a time, %3$s an amount. -->
    <string name="snowing_now_until">Snowing now %1$s until %2$s: about %3$s more.</string>
    <!-- %1$s is a day or part of a day, "Saturday morning"; %2$s an amount, "21 cm". -->
    <string name="good_day">%1$s: %2$s of fresh snow and clear skies.</string>
    <string name="no_good_day">No day with fresh snow and clear skies in the next five days.</string>
    <!-- %1$s is an amount, "95 cm"; %2$s a place phrase, "at the summit". -->
    <string name="snow_depth_model">About %1$s of snow on the ground %2$s (model estimate).</string>
    <!-- Read by TalkBack: %1$s is a temperature, "-4°". -->
    <string name="max_temperature">max %1$s</string>
    <!-- Read by TalkBack: %1$s is a weekday, "Friday". -->
    <string name="today_weekday">Today, %1$s</string>
    <!-- Read by TalkBack: %1$s is the day, %2$s what each level expects. -->
    <string name="day_summary">%1$s: %2$s</string>

    <!-- Advanced weather screen -->
    <string name="advanced_weather">Advanced Weather</string>
    <string name="forecast_unavailable">Forecast Unavailable</string>
    <string name="forecast_could_not_load">The forecast could not be loaded.</string>
    <string name="snow_and_rain_by_altitude">Snow and Rain by Altitude</string>
    <!-- The first column of the chart: the snow on the ground at each level, from the avalanche bulletin. -->
    <string name="ground">Ground</string>
    <!-- Legend entries. -->
    <string name="legend_snow">Snow</string>
    <string name="legend_rain">Rain</string>
    <string name="legend_freezing_level" translatable="false">0 °C</string>
    <!-- %1$s is an altitude, "1,300 m": the bulletin's snow line. -->
    <string name="snow_from">Snow from %1$s</string>
    <!-- Read by TalkBack: %1$s is an amount, "38 cm". -->
    <string name="amount_of_snow">%1$s of snow</string>
    <!-- Read by TalkBack, inside a sentence. -->
    <string name="rain_spoken">rain</string>
    <!-- %1$s is an altitude, "1,700 m". -->
    <string name="freezing_level_at">0 °C at %1$s</string>

    <!-- Snow on the ground and avalanche risk, from Météo-France's avalanche bulletin -->
    <string name="snow_on_the_ground">Snow on the Ground</string>
    <!-- %1$s is an altitude, "1,300 m". -->
    <string name="snow_line">Snow line %1$s</string>
    <!-- A depth figure, "105" or "125+" above the bulletin's altitudes. -->
    <string name="depth_figure_cm" translatable="false">%1$s cm</string>
    <!-- %1$s is an amount, "55 cm"; %2$d the days the change covers. -->
    <string name="snow_change_up">+%1$s in %2$d days</string>
    <string name="snow_change_down">-%1$s in %2$d days</string>
    <string name="snow_change_none">No change in %1$d days</string>
    <!-- What the figures are and the day they describe, as the licence asks: %1$s is "21 Nov". -->
    <string name="bulletin_source">Off-piste, Météo-France avalanche bulletin of %1$s</string>
    <!-- Read by TalkBack: %1$s is a list, "at least 125 cm at the summit and 105 cm in the village". -->
    <string name="snow_depth_spoken">Snow depth: %1$s.</string>
    <string name="at_least">at least %1$s</string>
    <string name="avalanche_risk">Avalanche Risk</string>
    <!-- Read by TalkBack: %1$s is "4/5 High above 2,200 m, 3/5 Considerable below". -->
    <string name="avalanche_risk_spoken">Avalanche risk: %1$s</string>
    <!-- %1$d is the level, %2$s its name: "4/5 High". -->
    <string name="avalanche_level">%1$d/5 %2$s</string>
    <!-- The European avalanche danger scale; Météo-France says faible, limité, marqué, fort, très fort. -->
    <string name="avalanche_low">Low</string>
    <string name="avalanche_moderate">Moderate</string>
    <string name="avalanche_considerable">Considerable</string>
    <string name="avalanche_high">High</string>
    <string name="avalanche_very_high">Very high</string>
    <!-- %1$s and %3$s are levels, "4/5 High"; %2$s the altitude where the bulletin splits them. -->
    <string name="avalanche_split">%1$s above %2$s, %3$s below</string>

    <!-- Webcam screen -->
    <string name="refresh">Refresh</string>
    <!-- %1$s is the webcam's name. -->
    <string name="latest_image_from">Latest image from %1$s</string>
    <string name="image_unavailable">Image unavailable</string>
    <string name="try_again">Try Again</string>
    <!-- %1$s is a viewing direction as published by the source. -->
    <string name="facing">Facing %1$s</string>
    <string name="source">Source</string>
    <!-- %1$s is the provider's name, e.g. Skaping. -->
    <string name="via_provider">via %1$s</string>
    <!-- %1$s is the image owner, e.g. Les Saisies; %2$s the provider. -->
    <string name="owner_via_provider">© %1$s · via %2$s</string>
    <string name="view_on_provider">View on %1$s</string>

    <!-- Snapshot freshness: %1$s is a time ("14:30") or a date ("11 Apr 2026") in the resort's time zone. -->
    <string name="freshness_updated">Updated %1$s</string>
    <string name="freshness_last_image">Last image %1$s</string>
    <string name="freshness_unknown">Time unknown</string>

    <!-- Webcam errors -->
    <string name="error_no_snapshot">This webcam has no image available.</string>
    <!-- %1$s is the provider's name, e.g. "Panomax". -->
    <string name="error_unsupported_provider">%1$s webcams are not supported yet.</string>
    <string name="error_latest_image_not_found">The latest image could not be found on the provider\'s page.</string>
    <string name="error_bad_status_code">The webcam server responded with an error (%1$d).</string>
    <string name="error_not_an_image">The webcam server did not return an image.</string>
    <string name="error_unreachable">The webcam server could not be reached.</string>
</resources>
