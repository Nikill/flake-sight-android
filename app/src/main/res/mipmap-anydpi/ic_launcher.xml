<?xml version="1.0" encoding="utf-8"?>
<!-- The iOS app icon (the mountain, default since 1.3), inset into the adaptive icon's safe zone on its corner colour. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground>
        <inset android:drawable="@drawable/ic_launcher_art_mountain" android:inset="19%" />
    </foreground>
</adaptive-icon>
